#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# KvantOS — применить фирменный фон Plasma в live-сессии.
# Ждём, пока plasmashell поднимется на сессионной шине, затем ставим
# обои штатным инструментом (работает и на Plasma 6).
wall=/usr/share/wallpapers/kvantos/aurora-minimal.png
[ -f "$wall" ] || exit 0

n=0
while [ "$n" -lt 30 ]; do
    if plasma-apply-wallpaperimage "$wall" >/dev/null 2>&1; then
        exit 0
    fi
    n=$((n + 1))
    sleep 1
done
exit 0
