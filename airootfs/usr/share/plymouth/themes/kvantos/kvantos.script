// KvantOS Plymouth theme — реализация спецификации v5 (README.txt).
// Орбита звезды: Rx=300 Ry=92, наклон -12°, период 3.2с.
// Свечение логотипа 1.0->1.2 с периодом 1.6с (8 прекомпилированных кадров).
// 140 звёзд (детерминированные), кометы только справа-налево и вниз,
// спавн каждые 3.2с, жизнь 1.55с. Бесшовный цикл 12.8с.

screen_w = Plymouth.GetScreenWidth();
screen_h = Plymouth.GetScreenHeight();
cx = screen_w / 2;
cy = screen_h / 2 + 30;

background = new Image("background.png");
logo_img = new Image("logo.png");
star_img = new Image("star.png");
comet_img = new Image("comet.png");

logo_frames = [];
for (i = 0; i < 8; i++)
    logo_frames[i] = new Image("logo_s" + i + ".png");

// фон
bg = Sprite(background);
bg.SetX(0); bg.SetY(0); bg.SetZ(0);

// логотип (анкер — центр)
logo_w = logo_img.GetWidth();
logo_h = logo_img.GetHeight();
logo = Sprite(logo_img);
logo.SetX(cx - logo_w / 2);
logo.SetY(cy - logo_h / 2);
logo.SetZ(10);

// орбiting звезда
star = Sprite(star_img);
star.SetZ(20);

// звёздное поле
