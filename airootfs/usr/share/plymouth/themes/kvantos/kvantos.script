star_sprites = [];
for (i = 0; i < STARS.length; i++) {
    s = STARS[i];
    sp = Sprite(new Image(s.img + ".png"));
    sp.SetX(s.x - 4); sp.SetY(s.y - 4); sp.SetZ(1);
    sp.SetOpacity(0.82); // 210/255
    star_sprites[i] = sp;
}

// кометы: головы + по 9 хвостовых точек
COMETS = [
  {t0:0.0,x0:2020,y0:323.5,x1:-274,y1:993.7},
  {t0:3.2,x0:2020,y0:84.9,x1:-186,y1:479.5},
  {t0:6.4,x0:2020,y0:110.1,x1:-250,y1:798.8},
  {t0:9.6,x0:2020,y0:338.3,x1:-342,y1:977.3}
];
comet_heads = [];
comet_tails = [];
for (i = 0; i < COMETS.length; i++) {
    h = Sprite(comet_img); h.SetZ(30);
    comet_heads[i] = h;
    tails = [];
    for (k = 0; k < 9; k++) {
        t = Sprite(new Image("dot_c23.png")); // яркая прохладная точка
        t.SetZ(29);
        tails[k] = t;
    }
    comet_tails[i] = tails;
}

PI = 3.14159265358979;
LOOP = 12800; // мс
TILT = -12 * PI / 180;
RX = 300; RY = 92;

fun min2(a, b) { if (a < b) return a; return b; }

fun refresh_callback() {
    t = Plymouth.GetMilliseconds() % LOOP;
    tt = t / 1000.0;

    // --- звезда на эллипсе, по часовой от угла 0 ---
    a = 2 * PI * (t / 3200.0);
    ex = RX * Math.cos(a);
    ey = RY * Math.sin(a);
    sx = cx + ex * Math.cos(TILT) - ey * Math.sin(TILT);
    sy = cy + ex * Math.sin(TILT) + ey * Math.cos(TILT);
    star.SetX(sx - star_img.GetWidth() / 2);
    star.SetY(sy - star_img.GetHeight() / 2);

    // --- свечение логотипа: 1.0 -> 1.2, период 1.6с (8 кадров) ---
    fi = Math.floor((t % 1600) / 200); // 0..7
    logo.SetImage(logo_frames[fi]);

    // --- мерцание звёзд ---
    for (i = 0; i < STARS.length; i++) {
        s = STARS[i];
        ph = ((tt / s.T) + s.ph) % 1.0;
        tw = 0.5 + 0.5 * Math.sin(2 * PI * ph);
        star_sprites[i].SetOpacity(0.82 * (0.35 + 0.65 * tw));
    }

    // --- кометы ---
    for (i = 0; i < COMETS.length; i++) {
        c = COMETS[i];
        local_t = t - c.t0 * 1000;
        if (local_t < 0 || local_t > 1550) {
            comet_heads[i].SetOpacity(0);
            for (k = 0; k < 9; k++) comet_tails[i][k].SetOpacity(0);
            continue;
        }
        p = local_t / 1550.0; // 0..1
        hx = c.x0 + (c.x1 - c.x0) * p;
        hy = c.y0 + (c.y1 - c.y0) * p;
        fade = Math.sin(PI * p);
        // направление (справа налево и вниз)
        dx = c.x1 - c.x0; dy = c.y1 - c.y0;
        len = Math.sqrt(dx*dx + dy*dy);
        ux = dx / len; uy = dy / len;
        comet_heads[i].SetX(hx - comet_img.GetWidth() / 2);
        comet_heads[i].SetY(hy - comet_img.GetHeight() / 2);
        comet_heads[i].SetOpacity(fade);
        for (k = 0; k < 9; k++) {
            kk = (k + 1) / 9.0;
            tx2 = hx - ux * 14 * (k + 1);
            ty2 = hy - uy * 14 * (k + 1);
            size = 7.5 * (1 - kk) + 1.2;
            alpha = Math.pow(1 - kk, 1.4) * 235 / 255 * fade;
            sp = comet_tails[i][k];
            sp.SetX(tx2 - size / 2); sp.SetY(ty2 - size / 2);
            sp.SetOpacity(alpha);
        }
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
